# Copy to backend/.env and supply your own OpenAI-compatible chat API.
# Include the API version/path (often /v1). Do not add /chat/completions.
LLM_BASE_URL=
LLM_MODEL=
# Optional for local servers that do not require authentication.
LLM_API_KEY=
# Optional display label; this does not select a built-in provider.
LLM_PROVIDER=custom
# Enable only if your endpoint supports response_format: json_object.
LLM_JSON_MODE=false
LLM_TIMEOUT_SECONDS=90
