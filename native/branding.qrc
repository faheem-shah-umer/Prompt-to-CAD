        <file alias="cross.svg">../assets/icons/cross.svg</file>
        <file alias="cube.svg">../assets/icons/cube.svg</file>
        <file alias="disk.svg">../assets/icons/disk.svg</file>
        <file alias="edit.svg">../assets/icons/edit.svg</file>
        <file alias="folder-open.svg">../assets/icons/folder-open.svg</file>
        <file alias="folder.svg">../assets/icons/folder.svg</file>
        <file alias="menu-dots.svg">../assets/icons/menu-dots.svg</file>
        <file alias="redo.svg">../assets/icons/redo.svg</file>
