{
  "schema_version": 1,
  "name": "Gaming controller reference",
  "units": "mm",
  "parameters": {
    "button_spacing": 12,
    "button_cluster_x": 43,
    "button_cluster_y": 15
  },
  "components": [
    {
      "id": "body",
      "name": "Controller body",
      "color": "#30343a",
      "parameters": {
        "width": 140,
        "depth": 70,
        "thickness": 20,
        "corner_radius": 6
      },
      "features": [
        {
          "id": "body_blank",
          "type": "box",
          "operation": "new",
          "size": [
            "width",
            "depth",
            "thickness"
          ]
        },
        {
          "id": "body_corners",
          "type": "fillet",
          "edges": "|Z",
          "size": "corner_radius"
        }
      ],
      "expected_size": [
        "width",
        "depth",
        "thickness"
      ]
    },
    {
      "id": "left_grip",
      "name": "Left grip",
      "color": "#141519",
      "parameters": {
        "length": 40,
        "root_width": 28,
        "root_height": 18,
        "middle_width": 30,
        "middle_height": 24,
        "tip_width": 12,
        "tip_height": 12,
        "x_offset": -45
      },
      "placement": {
        "translation": [
          "x_offset",
          "-body.depth / 2",
          0
        ]
      },
      "features": [
        {
          "id": "root_profile",
          "type": "sketch",
          "profile": "ellipse",
          "plane": "XZ",
          "width": "root_width",
          "height": "root_height"
        },
        {
          "id": "middle_profile",
          "type": "sketch",
          "profile": "ellipse",
          "plane": "XZ",
          "origin": [
            0,
            "-length / 2",
            -3
          ],
          "width": "middle_width",
          "height": "middle_height"
        },
        {
          "id": "tip_profile",
          "type": "sketch",
          "profile": "ellipse",
          "plane": "XZ",
          "origin": [
            0,
            "-length",
            -6
          ],
          "width": "tip_width",
          "height": "tip_height"
        },
        {
          "id": "grip_loft",
          "type": "loft",
          "operation": "new",
          "sketches": [
            "root_profile",
            "middle_profile",
            "tip_profile"
          ]
        }
      ]
    },
    {
      "id": "right_grip",
      "name": "Right grip",
      "color": "#141519",
      "parameters": {
        "length": 40,
        "root_width": 28,
        "root_height": 18,
