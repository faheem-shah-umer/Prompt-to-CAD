          "sketches": [
            "root_profile",
            "middle_profile",
            "tip_profile"
          ]
        }
      ]
    },
    {
      "id": "left_joystick",
      "name": "Left joystick",
      "color": "#141519",
      "parameters": {
        "stem_radius": 6,
        "cap_radius": 10,
        "stem_height": 6,
        "cap_height": 3,
        "x_offset": -25,
        "y_offset": -15
      },
      "placement": {
        "translation": [
          "x_offset",
          "y_offset",
          "body.thickness / 2"
        ]
      },
      "features": [
        {
          "id": "stem",
          "type": "cylinder",
          "operation": "new",
          "radius": "stem_radius",
          "height": "stem_height"
        },
        {
          "id": "thumb_cap",
          "type": "cylinder",
          "operation": "add",
          "radius": "cap_radius",
          "height": "cap_height",
          "placement": {
            "translation": [
              0,
              0,
              "stem_height"
            ]
          }
        }
      ],
      "expected_size": [
        "cap_radius * 2",
        "cap_radius * 2",
        "stem_height + cap_height"
      ]
    },
    {
      "id": "right_joystick",
      "name": "Right joystick",
      "color": "#141519",
      "parameters": {
        "stem_radius": 6,
        "cap_radius": 10,
        "stem_height": 6,
        "cap_height": 3,
        "x_offset": 25,
        "y_offset": -15
      },
      "placement": {
        "translation": [
          "x_offset",
