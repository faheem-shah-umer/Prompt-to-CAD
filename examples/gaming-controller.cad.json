      "id": "dpad",
      "name": "Directional pad",
      "color": "#141519",
      "parameters": {
        "span": 20,
        "arm_width": 7,
        "height": 3,
        "x_offset": -43,
        "y_offset": 15
      },
      "placement": {
        "translation": [
          "x_offset",
          "y_offset",
          "body.thickness / 2"
        ]
      },
      "features": [
        {
          "id": "cross_profile",
          "type": "sketch",
          "profile": "polygon",
          "points": [
            [
              "-arm_width / 2",
              "-span / 2"
            ],
            [
              "arm_width / 2",
              "-span / 2"
            ],
            [
              "arm_width / 2",
              "-arm_width / 2"
            ],
            [
              "span / 2",
              "-arm_width / 2"
            ],
            [
              "span / 2",
              "arm_width / 2"
            ],
            [
              "arm_width / 2",
              "arm_width / 2"
            ],
            [
              "arm_width / 2",
              "span / 2"
            ],
            [
              "-arm_width / 2",
              "span / 2"
            ],
            [
              "-arm_width / 2",
              "arm_width / 2"
            ],
            [
              "-span / 2",
              "arm_width / 2"
            ],
            [
              "-span / 2",
              "-arm_width / 2"
            ],
            [
              "-arm_width / 2",
              "-arm_width / 2"
            ]
          ]
        },
        {
          "id": "raised_cross",
          "type": "extrude",
          "operation": "new",
          "sketch": "cross_profile",
          "distance": "height"
        }
      ],
      "expected_size": [
        "span",
        "span",
        "height"
      ]
    },
    {
