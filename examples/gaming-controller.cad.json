      },
      "features": [
        {
          "id": "root_profile",
          "type": "sketch",
          "profile": "ellipse",
          "plane": "XZ",
          "width": "root_width",
          "height": "root_height"
        },
        {
          "id": "middle_profile",
          "type": "sketch",
